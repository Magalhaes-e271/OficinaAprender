# Banco de desenvolvimento iniciado por docker compose
POSTGRES_DB=oficina_aprender
POSTGRES_USER=oficina_user
POSTGRES_PASSWORD=COLOQUE_UMA_SENHA_LOCAL_FORTE
POSTGRES_PORT=5436
# Spring Boot lê estas variáveis do ambiente do processo, não importa .env automaticamente.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5436/oficina_aprender
# SPRING_DATASOURCE_USERNAME=oficina_user
# SPRING_DATASOURCE_PASSWORD=COLOQUE_A_MESMA_SENHA_LOCAL
# JWT_SECRET=COLOQUE_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_BYTES
# Gere MFA_ENCRYPTION_KEY neste arquivo com: python scripts/configurar_mfa.py --env .env
# Carregue este .env no processo Java. Preserve uma chave MFA existente.
# AUTH_ACCOUNT_ATTEMPTS=10
# AUTH_IP_ATTEMPTS=120
# AUTH_WINDOW_SECONDS=900
# CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
